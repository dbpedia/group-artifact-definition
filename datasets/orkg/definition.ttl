@prefix databus: <https://dataid.dbpedia.org/databus#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rule: <https://example.org/rule#> .
@prefix schema: <https://schema.org/> .
@prefix user: <https://databus.dbpedia.org/knowledge-graph-catalog/> .

user:orkg a databus:Group ;
    dct:title "ORKG" ;
    dct:description "The Open Research Knowledge Graph provides scholarly knowledge as a KG enabling querying, comparison, and reuse of scientific information." ;
    dct:abstract "The Open Research Knowledge Graph provides scholarly knowledge as a KG enabling querying, comparison, and reuse of scientific information." ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/rdf> ;
    rule:hasArtifact <orkg-daily-dump> .

<orkg-daily-dump> a databus:Artifact ;
    dct:title "ORKG Daily dump" ;
    dct:description "The Open Research Knowledge Graph provides scholarly knowledge as a KG enabling querying, comparison, and reuse of scientific information." ;
    dct:abstract "The Open Research Knowledge Graph provides scholarly knowledge as a KG enabling querying, comparison, and reuse of scientific information." ;
    schema:keywords "rdf", "knowledge graph", "scholarly knowledge", "entities", "relations" .